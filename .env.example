# Copy to .env and fill in. On Railway, set these in the service Variables tab.

# Postgres connection string (Railway provides this on the Postgres plugin).
# Leave blank to run the site with fallback content; the apply wizard and admin
# need a database.
DATABASE_URL=

# Set to "disable" only if connecting to a local Postgres without SSL.
# PGSSL=disable

# Seed the first admin on deploy (optional). The migrate step (which runs on
# every deploy) creates this admin only if it doesn't already exist — it never
# overwrites an existing account. Set both in the Railway Variables tab, sign in
# at /login, then you can safely remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (verification + magic-link sign-in). Without RESEND_API_KEY, links are
# logged to the server console instead of sent — fine for dev / before setup.
# Get a key at resend.com; RESEND_FROM must be a sender on a domain you've
# verified in Resend (e.g. "Traxn <hello@yourdomain.com>"). The default
# onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM=Traxn <onboarding@resend.dev>

# Public base URL for links in emails. If unset, derived from the request host.
# Set this on Railway to your real domain so email links point at it.
APP_URL=
