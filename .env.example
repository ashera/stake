# Copy to .env and fill in. On Railway, set these in the service Variables tab.

# Postgres connection string (Railway provides this on the Postgres plugin).
# Leave blank to run the site without a database — applications will be logged
# to the server console instead of saved.
DATABASE_URL=

# Set to "disable" only if connecting to a local Postgres without SSL.
# PGSSL=disable

# Seed the first admin on deploy (optional). The migrate step (which runs on
# every deploy) creates this admin only if it doesn't already exist — it never
# overwrites an existing account. Set both in the Railway Variables tab, sign in
# at /login, then you can safely remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
